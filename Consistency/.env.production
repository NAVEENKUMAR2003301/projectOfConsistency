# Build-time configuration for production deploys.
#
# This is NOT a secret: the URL is compiled into the client bundle and is
# visible to anyone who opens the site. Keeping it in the repo means a Vercel
# build needs no dashboard configuration and stays reproducible.
#
# The worker enforces its own access control — CORS restricted to this site's
# origin, and a session token required on every route that touches your data.
#
# A Vercel dashboard environment variable of the same name would override this.
VITE_API_URL=https://consistency-reminders.naveen-consistency.workers.dev
